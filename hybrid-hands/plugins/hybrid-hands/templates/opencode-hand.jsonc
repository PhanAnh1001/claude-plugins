// OpenCode config for hand-ext runs (passed via OPENCODE_CONFIG; user config is not edited).
// Permission syntax: https://opencode.ai/docs/permissions (11/2026) - glob `*`/`?`,
// last matching rule wins, so the catch-all "*" comes first.
// Sandbox "read-only" -> `--agent hand-readonly` (defined below: edit deny, bash read-only).
{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env*": "deny"
    },
    "bash": {
      "*": "allow",
      "*.env*": "deny",
      "*.env *": "deny",
      "cat .env*": "deny",
      "* .env*": "deny",
      "*/.env*": "deny",
      "env": "deny",
      "printenv*": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env*": "deny"
    },
    "external_directory": "deny",
    "webfetch": "allow"
  },
  "agent": {
    "hand-readonly": {
      "description": "hand-ext read-only run: inspect and report, never modify files",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git show*": "allow",
          "ls*": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "*.env*": "deny"
        }
      }
    }
  }
}
