#!/usr/bin/env python3
"""Fake `paseo` for cc-switch tests: log argv, then answer by scenario env."""
import json
import os
import sys

LOG_ENV = "CC_SWITCH_CALL_LOG"


def log_call() -> None:
    path = os.environ.get(LOG_ENV)
    if not path:
        return
    with open(path, "a", encoding="utf-8") as handle:
        handle.write(json.dumps({
            "cmd": "paseo", "argv": sys.argv[1:], "cwd": os.getcwd(),
        }) + "\n")


def emit(text: str) -> None:
    if text:
        sys.stdout.write(text)


def main() -> int:
    log_call()
    args = sys.argv[1:]
    head = args[0] if args else ""
    if head == "ls":
        emit(os.environ.get("PASEO_FAKE_LS_STDOUT", "[]"))
        stderr = os.environ.get("PASEO_FAKE_LS_STDERR", "")
        if stderr:
            sys.stderr.write(stderr)
        return int(os.environ.get("PASEO_FAKE_LS_EXIT", "0"))
    if head == "wait":
        return int(os.environ.get("PASEO_FAKE_WAIT_EXIT", "0"))
    if args[:2] == ["agent", "reload"]:
        emit(os.environ.get("PASEO_FAKE_RELOAD_STDOUT", "STATUS\nreloaded\n"))
        stderr = os.environ.get("PASEO_FAKE_RELOAD_STDERR", "")
        if stderr:
            sys.stderr.write(stderr)
        return int(os.environ.get("PASEO_FAKE_RELOAD_EXIT", "0"))
    if head == "import":
        default = "Importing provider session...\n" + json.dumps({
            "agentId": "99999999-8888-7777-6666-555555555555",
            "status": "created",
        }) + "\n"
        emit(os.environ.get("PASEO_FAKE_IMPORT_STDOUT", default))
        stderr = os.environ.get("PASEO_FAKE_IMPORT_STDERR", "")
        if stderr:
            sys.stderr.write(stderr)
        return int(os.environ.get("PASEO_FAKE_IMPORT_EXIT", "0"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
