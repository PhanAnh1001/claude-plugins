#!/usr/bin/env python3
"""Fake `claude` for cc-switch tests: log argv/cwd instead of starting a TUI."""
import json
import os
import sys

LOG_ENV = "CC_SWITCH_CALL_LOG"


def main() -> int:
    path = os.environ.get(LOG_ENV)
    if path:
        with open(path, "a", encoding="utf-8") as handle:
            handle.write(json.dumps({
                "cmd": "claude", "argv": sys.argv[1:], "cwd": os.getcwd(),
            }) + "\n")
    print("fake claude: " + " ".join(sys.argv[1:]))
    return int(os.environ.get("CLAUDE_FAKE_EXIT", "0"))


if __name__ == "__main__":
    sys.exit(main())
