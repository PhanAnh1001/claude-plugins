--- baseline/hybrid-hands/plugins/hybrid-hands/CHANGELOG.md
+++ hybrid-hands/plugins/hybrid-hands/CHANGELOG.md
@@ -2,6 +2,7 @@
 
 ## 0.28.0
 
+- User-Agent của hand-ext dsh lấy phiên bản từ manifest plugin, tránh lệch phiên bản khi release.
 - Sửa cc-switch --self báo nhầm PID TUI đã được reap còn sống khi tiến trình kết thúc giữa liveness probe và ps; kiểm tra lại PID khi ps không còn state.
 - Panel agent/sidebar Paseo gọn: icon, tên, model·effort, elapsed, USD~; quota tài khoản mỗi account plan chỉ ở root, bỏ header/footer và nhãn lặp.
 - Mỗi cây hiện tối đa 4 phiên phụ, chỉ phiên hoạt động gần nhất mở tối đa 4 subagent/hand có cha; phần cũ gộp done/error/running/unknown, không mất số đếm phiên ẩn. Running ưu tiên, tie giữ thứ tự duyệt cây/agent đầu vào; lỗi có precedence trên trạng thái running cũ.
--- baseline/hybrid-hands/plugins/hybrid-hands/lib/hand_ext/backends/dsh.py
+++ hybrid-hands/plugins/hybrid-hands/lib/hand_ext/backends/dsh.py
@@ -70,7 +70,20 @@
 DEFAULT_BASE_URL = "https://opencode.ai/inference/go/openai/v1"
 GO_MODEL_PREFIX = "opencode-go/"  # accepted and stripped: provider-prefixed Go model id
 EFFORTS = frozenset({"off", "low", "high", "max"})
-USER_AGENT = "hybrid-hands-hand-ext/0.27.0"  # Go asks third-party clients for their own UA
+
+
+def _plugin_version() -> str:
+    try:
+        manifest = json.loads((PLUGIN_ROOT / ".claude-plugin" / "plugin.json").read_text(encoding="utf-8"))
+        version = manifest.get("version") if isinstance(manifest, dict) else None
+        if isinstance(version, str) and re.fullmatch(r"[0-9A-Za-z.+-]+", version):
+            return version
+    except (OSError, ValueError, UnicodeError):
+        pass
+    return "unknown"
+
+
+USER_AGENT = f"hybrid-hands-hand-ext/{_plugin_version()}"  # Go asks clients for their own UA
 KEY_FILE_MODE = 0o600
 # Per-run overlay: dsh applies --patch in argv order, so this wins over hand.patch.yml.
 COMPACTION_PATCH_FILE = "compaction.patch.yml"
